# Set in Vercel → Project → Settings → Environment Variables. Nothing here is needed for `npm run dev`.

# Added automatically by the Supabase integration on Vercel:
POSTGRES_URL=            # the pooled database address; the server's only way into the database
SUPABASE_URL=            # used only to check operator sign-ins
SUPABASE_ANON_KEY=       # public key, used only to check operator sign-ins

# Add these yourself:
DEVICE_SALT=             # a long random string; device cookies are stored only as a hash salted with this. Never change it after launch.
CRON_SECRET=             # a long random string; lets Vercel's scheduled jobs call /api/cron/*
PUBLIC_ORIGIN=           # the site's own address, e.g. https://example.org (no trailing slash)
OPS_WEBHOOK_URL=         # optional: where the daily operator notice is posted (for example a Slack webhook)

# Off at launch. Email reminders need all three:
# EMAIL_REMINDERS=on
# RESEND_API_KEY=
# EMAIL_FROM=

# The testing deployment only. Never set these in production:
# TEST_MODE=1
# VITE_TEST_MODE=1

# For `npm run test:db` on your own machine: a throwaway Postgres, never the production database.
# GT_TEST_DB=postgres://localhost:5432/giving_tree_test
